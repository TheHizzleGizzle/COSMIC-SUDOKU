{
  "name": "cosmic-sudoku",
  "version": "0.0.0",
  "private": true,
  "description": "Cosmic Sudoku: an offline-first cosmic Sudoku game for the web and Android.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.43.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
