{
  "name": "cosmic-sudoku",
  "version": "0.0.0",
  "private": true,
  "description": "Cosmic Sudoku: an offline-first cosmic Sudoku game for the web and Android.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "build:native": "vite build --mode native",
    "android:sync": "pnpm build:native && cap sync android",
    "android:debug": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.43.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
