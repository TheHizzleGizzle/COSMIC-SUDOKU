<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older. Only the Capacitor Preferences file is backed up:
     it holds the saved game, profile and settings. Caches are not included. -->
<full-backup-content>
    <include domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>
