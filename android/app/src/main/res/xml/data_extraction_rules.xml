<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer on Android 12 and newer. Same single file as
     backup_rules.xml: the Capacitor Preferences store ("CapacitorStorage"). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
